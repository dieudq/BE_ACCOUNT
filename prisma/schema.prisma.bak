// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// WEBHOOK RECEIVER - Voucher Records
// ========================================

model Voucher {
  id          String   @id @default(cuid())
  code        String   @unique // PT_xxx / PC_xxx from ERP
  voucherType String   // RECEIPT / PAYMENT
  
  issueDate   DateTime // Ngày thu/chi
  postingDate DateTime? // Ngày hạch toán

  content String   // Nội dung thu/chi
  
  // Account info
  accountId   String?  // Tài khoản thu/chi ID (from ERP)
  accountName String?  // Tài khoản thu/chi Name
  accountCode String?  // Tài khoản thu/chi Code
  
  // Partner/Payer/Receiver
  partnerCode    String? // Mã đối tượng
  payerReceiver  String? // Người nộp/nhận tiền
  bankAccount    String? // Số tài khoản nộp/nhận
  bankCode       String? // Ngân hàng nộp/nhận
  
  note           String? // Ghi chú
  attachments    String[]? // File IDs
  
  // Currency & Amount
  currency       String  @default("VND")
  exchangeRate   Decimal? @db.Decimal(18, 6)
  taxIncluded    Boolean @default(false)
  totalAmount    Decimal @db.Decimal(18, 2) // Tổng tiền
  
  // Status & Approval
  status         String  @default("DRAFT") // DRAFT, PROCESSING, APPROVED, REJECTED, CANCELLED
  
  // Creator info (from ERP)
  createdByUserId    String? // User ID (from ERP)
  createdByEmail     String? // User email
  createdByFullName  String? // User full name
  
  // Assigned Users (to notify via Telegram)
  assignedUserIds    String[]? // List of user IDs to notify (será llenado por backend)
  
  // Webhook & Sync
  webookReceivedAt   DateTime @default(now()) // Khi webhook được nhận
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  details VoucherDetail[]
  approvals VoucherApproval[]
  
  @@map("voucher")
}

model VoucherDetail {
  id          String  @id @default(cuid())
  voucherId   String
  voucher     Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  
  // Description & Amount
  description String  // Diễn giải chi tiết
  quantity    Int     @default(1)
  amount      Decimal @db.Decimal(18, 2)
  
  // Categories
  expenseCategory String? // EXPENSE_CATEGORY, REVENUE_CATEGORY
  expenseObject   String? // EXPENSE_OBJECT, REVENUE_OBJECT
  
  // Related entities (optional - from ERP)
  employeeId  String?
  projectId   String?
  customerId  String?
  supplierId  String?
  
  // Employee (nếu có)
  employeeName String?
  
  // Project (nếu có)
  projectName String?
  projectCode String?
  
  // Customer/Supplier (nếu có)
  customerName String?
  supplierName String?
  
  // Tax
  taxRate     Decimal? @db.Decimal(5, 2)
  taxAmount   Decimal? @db.Decimal(18, 2)
  totalAmount Decimal  @db.Decimal(18, 2)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("voucher_detail")
}

model VoucherApproval {
  id         String  @id @default(cuid())
  voucherId  String
  voucher    Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  
  // Approver info
  approverUserId String?
  approverEmail  String?
  approverName   String?
  
  status     String  @default("PENDING") // PENDING, APPROVED, REJECTED, SKIPPED
  comments   String?
  index      Int     @default(0) // Thứ tự duyệt
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@map("voucher_approval")
}

// ========================================
// USER LINKING - Telegram IDs
// ========================================

model UserLink {
  id            String  @id @default(cuid())
  email         String  @unique // Email (key từ ERP User)
  telegramId    String? @unique // Telegram user ID (khi link)
  telegramName  String? // Telegram username
  
  isLinked      Boolean @default(false)
  linkedAt      DateTime? // Khi link xong
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("user_link")
}
